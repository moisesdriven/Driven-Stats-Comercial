# =====================================================================
# Driven Comercial · variables de entorno
# Copia este archivo a .env (local) o al .env del servidor (lo genera
# scripts/deploy/01-preparar-servidor.ps1). Nunca subas el .env real.
# =====================================================================

# ---------- Base de datos (PostgreSQL propio: contenedor comercial-db, aislado de DrivenBox) ----------
# Superusuario de la instancia propia. Solo lo usan el contenedor db y el script que crea esquemas y roles.
POSTGRES_PASSWORD=CAMBIAR
# Rol de la web: lectura/escritura solo en el esquema "comercial".
DATABASE_URL=postgres://comercial_web:CAMBIAR@comercial-db:5432/comercial
# Rol del worker: "comercial" y "comercial_cola" (pg-boss).
DATABASE_URL_WORKER=postgres://comercial_worker:CAMBIAR@comercial-db:5432/comercial
# Rol migrador: dueño del esquema "comercial", solo para ejecutar migraciones.
DATABASE_URL_MIGRADOR=postgres://comercial_migrador:CAMBIAR@comercial-db:5432/comercial
# Base desechable para pruebas de integración (solo desarrollo y CI, nunca la de producción).
DATABASE_URL_TEST=postgres://postgres:postgres@127.0.0.1:5432/comercial_test

# ---------- Seguridad ----------
# Clave AES-256-GCM para cifrar los tokens de GHL y los secretos TOTP: 32 bytes en base64.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLAVE_CIFRADO=
# Secreto para firmar las sesiones (mínimo 32 caracteres aleatorios).
SESION_SECRETO=
# URL pública del sistema (se usa en correos y cookies Secure).
URL_PUBLICA=https://comercial.drivenbox.drivenautomations.com

# ---------- GHL ----------
# Base de la app de GHL para los enlaces "Abrir en GHL" (cambiar si la agencia usa marca blanca).
GHL_URL_APP=https://app.gohighlevel.com
# Solo desarrollo (fase 2): PIT de solo lectura y locationId de la subcuenta piloto para inspeccionar
# mensajes reales. En producción los tokens se dan de alta desde la interfaz y se guardan cifrados.
GHL_PIT_PILOTO=
GHL_LOCATION_ID_PILOTO=
# Hora de la carga nocturna (hora de Lima). Distinta a las cargas de Driven Conteo, que consulta las mismas subcuentas.
SYNC_NOCTURNO_HORA=02:30
# Intervalo de la carga incremental, en minutos.
SYNC_INCREMENTAL_MINUTOS=15
# Máximo de llamadas a GHL cada 10 s por subcuenta (GHL permite 100; se deja margen para Driven Conteo).
GHL_MAX_LLAMADAS_10S=80

# ---------- Análisis de calidad (Anthropic) ----------
# Clave de la API de Anthropic (Batches API). Sin ella, los análisis quedan en espera.
ANTHROPIC_API_KEY=
IA_MODELO=claude-haiku-5-5
# Esfuerzo del modelo al calificar (low | medium | high) y pensamiento adaptativo (si | no).
# Cambiarlos solo después de medirlos con `calidad-calibrar` (docs/calibracion/).
IA_ESFUERZO=low
IA_PENSAMIENTO=no
# Tope de gasto mensual en dólares; si un análisis lo superaría, se detiene y avisa.
IA_TOPE_MENSUAL_USD=10
CALIDAD_MUESTRA_CONVERSACIONES=1000
CALIDAD_MAX_MENSAJES_CONVERSACION=10
CALIDAD_MAX_MANUALES_MES=3

# ---------- Alertas y correo ----------
# sombra = calcula y registra sin enviar; activo = envía.
MODO_ALERTAS=sombra
SMTP_HOST=
SMTP_PUERTO=587
SMTP_USUARIO=
SMTP_CLAVE=
SMTP_REMITENTE=Driven Comercial <no-responder@ejemplo.com>

# ---------- General ----------
ZONA_HORARIA_DEFECTO=America/Lima
# Puerto local de la web en el servidor (solo 127.0.0.1). Verificar que no choque con Driven Conteo.
PUERTO_WEB=3100
# Publicación con Traefik (docker-compose.prod.yml).
DOMINIO=comercial.drivenbox.drivenautomations.com
LOG_NIVEL=info
